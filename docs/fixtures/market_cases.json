{
  "description": "v4 市场契约用例（M0_CONTRACT_FREEZE §14.7.2 / DECISION_LOG §17 Q4 / STATUS-49/51）。oracle: scripts/lib/market-oracle.mjs。数值均为 [PLACEHOLDER] 测试参数，不是标定结论。",
  "cases": [
    {
      "id": "MC-01",
      "desc": "初始市场恰 4 个企划（STATUS-49/51）",
      "op": "initial",
      "input": { "seed": 42 },
      "expect": { "count": 4 }
    },
    {
      "id": "MC-02",
      "desc": "每周自然补充：存活企划逐字段不变，不清空重抽",
      "op": "topup",
      "input": {
        "seed": 42, "week": 1, "params": { "weekly_add": 2 },
        "slots": [
          { "id": "o0", "expires_week": 5, "locked_until": null, "lock_used": false, "deposit_paid": 0, "contract_budget": 10000000 },
          { "id": "o1", "expires_week": 6, "locked_until": null, "lock_used": false, "deposit_paid": 0, "contract_budget": 20000000 }
        ]
      },
      "expect": { "kept_identical": true, "added_count": 2, "total": 4 }
    },
    {
      "id": "MC-03",
      "desc": "补充不超过上限 10",
      "op": "topup",
      "input": {
        "seed": 42, "week": 1, "params": { "weekly_add": 5, "market_cap": 10 },
        "slots": [
          { "id": "a0", "expires_week": 9, "locked_until": null, "lock_used": false, "deposit_paid": 0 },
          { "id": "a1", "expires_week": 9, "locked_until": null, "lock_used": false, "deposit_paid": 0 },
          { "id": "a2", "expires_week": 9, "locked_until": null, "lock_used": false, "deposit_paid": 0 },
          { "id": "a3", "expires_week": 9, "locked_until": null, "lock_used": false, "deposit_paid": 0 },
          { "id": "a4", "expires_week": 9, "locked_until": null, "lock_used": false, "deposit_paid": 0 },
          { "id": "a5", "expires_week": 9, "locked_until": null, "lock_used": false, "deposit_paid": 0 },
          { "id": "a6", "expires_week": 9, "locked_until": null, "lock_used": false, "deposit_paid": 0 },
          { "id": "a7", "expires_week": 9, "locked_until": null, "lock_used": false, "deposit_paid": 0 },
          { "id": "a8", "expires_week": 9, "locked_until": null, "lock_used": false, "deposit_paid": 0 }
        ]
      },
      "expect": { "added_count": 1, "total": 10 }
    },
    {
      "id": "MC-04",
      "desc": "自然过期：week > expires_week 的未锁定企划被移除",
      "op": "expire",
      "input": {
        "week": 5,
        "slots": [
          { "id": "e0", "expires_week": 4, "locked_until": null },
          { "id": "e1", "expires_week": 5, "locked_until": null },
          { "id": "e2", "expires_week": 6, "locked_until": null }
        ]
      },
      "expect": { "remaining_ids": ["e1", "e2"] }
    },
    {
      "id": "MC-05",
      "desc": "锁定保护：锁定期内超过 expires_week 仍保留（STATUS-49/51）",
      "op": "expire",
      "input": {
        "week": 6,
        "slots": [
          { "id": "L0", "expires_week": 4, "locked_until": 7 },
          { "id": "L1", "expires_week": 4, "locked_until": null }
        ]
      },
      "expect": { "remaining_ids": ["L0"] }
    },
    {
      "id": "MC-06",
      "desc": "锁定到期未接单：释放槽位（即使自然有效期未到）",
      "op": "release_locks",
      "input": {
        "week": 8,
        "slots": [
          { "id": "L0", "expires_week": 20, "locked_until": 7 },
          { "id": "L1", "expires_week": 20, "locked_until": 8 },
          { "id": "N0", "expires_week": 20, "locked_until": null }
        ]
      },
      "expect": { "remaining_ids": ["L1", "N0"] }
    },
    {
      "id": "MC-07",
      "desc": "lock_offer 成功：locked_until=week+2、lock_used=true、deposit_paid 记录",
      "op": "lock",
      "input": {
        "week": 5, "deposit": 800000,
        "offer": { "id": "o", "expires_week": 8, "locked_until": null, "lock_used": false, "deposit_paid": 0 }
      },
      "expect": { "error": null, "locked_until": 7, "lock_used": true, "deposit_paid": 800000 }
    },
    {
      "id": "MC-08",
      "desc": "终身一次：lock_used=true 的企划再次锁定被拒",
      "op": "lock",
      "input": {
        "week": 10, "deposit": 800000,
        "offer": { "id": "o", "expires_week": 30, "locked_until": null, "lock_used": true, "deposit_paid": 800000 }
      },
      "expect": { "error": "INVALID_INPUT" }
    },
    {
      "id": "MC-09",
      "desc": "已过期企划不可锁定",
      "op": "lock",
      "input": {
        "week": 9, "deposit": 800000,
        "offer": { "id": "o", "expires_week": 8, "locked_until": null, "lock_used": false, "deposit_paid": 0 }
      },
      "expect": { "error": "NOT_FOUND" }
    },
    {
      "id": "MC-10",
      "desc": "定金 100% 抵扣：cash_due = 应付款 − 定金，不重复计成本",
      "op": "deduct",
      "input": {
        "totalPayable": 10000000,
        "offer": { "id": "o", "deposit_paid": 800000 }
      },
      "expect": { "cash_due": 9200000, "deposit_applied": 800000 }
    },
    {
      "id": "MC-11",
      "desc": "企划 id 终身唯一：历史 id 复用被拒（防删除再生成绕过）",
      "op": "id_reuse",
      "input": { "id": "offer_x_3_1", "historyIds": ["offer_x_3_1", "offer_y_2_0"] },
      "expect": { "reuse": true }
    },
    {
      "id": "MC-12",
      "desc": "坐标式随机：同 (seed,week,index) 企划逐字段一致",
      "op": "determinism",
      "input": { "seed": 99, "week": 4, "index": 2 },
      "expect": { "identical": true }
    },
    {
      "id": "MC-13",
      "desc": "坐标敏感：不同周生成不同企划 id",
      "op": "week_sensitivity",
      "input": { "seed": 99, "week": 4, "index": 2 },
      "expect": { "identical": false }
    },
    {
      "id": "MC-14",
      "desc": "热度由坐标决定：同 (seed,week,genre) 恒等，取值合法",
      "op": "heat",
      "input": { "seed": 42, "week": 3, "genre": "action" },
      "expect": { "deterministic": true, "valid_level": true }
    }
  ]
}